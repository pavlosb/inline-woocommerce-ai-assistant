{
  "name": "inline-woocommerce-ai-assistant",
  "version": "0.1.1",
  "private": true,
  "description": "Development and integration-test tooling for INLINE WooCommerce AI Assistant.",
  "scripts": {
    "env:start": "wp-env start --update",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy --force",
    "test:php": "wp-env run cli --env-cwd=wp-content/plugins/inline-woocommerce-ai-assistant phpunit -- --configuration phpunit.xml.dist"
  },
  "devDependencies": {
    "@wordpress/env": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
